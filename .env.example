# LLM Provider Configuration
LLM_PROVIDER=anthropic  # Options: anthropic, openai, deepseek
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
DEEPSEEK_API_KEY=sk-xxxxx

# Model Settings
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4-turbo-preview
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# DeepSeek Advanced Settings (Optional)
# DEEPSEEK_BASE_URL=https://api.deepseek.com  # Custom API endpoint
# DEEPSEEK_TIMEOUT=60  # Request timeout in seconds
# DEEPSEEK_MAX_RETRIES=3  # Maximum number of retry attempts
# DEEPSEEK_STREAMING=false  # Enable streaming responses

# Embeddings
GOOGLE_API_KEY=xxxxx  # For Google Gemini Text Embeddings

# Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls_xxxxx
LANGSMITH_PROJECT=koder
LOG_LEVEL=INFO

# Storage Paths
VECTOR_STORE_PATH=./data/vector_store
CHECKPOINT_PATH=./data/checkpoints/checkpoints.db
CACHE_PATH=./data/cache

# Optional: MCP Server Configuration
MCP_SERVER_URL=http://localhost:8000

# Web Search Configuration
WEB_SEARCH_BACKEND=tavily  # Options: duckduckgo (free), tavily (AI-optimized), brave (privacy)
TAVILY_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_SAFE_SEARCH=true
